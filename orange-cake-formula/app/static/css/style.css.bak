:root {
  --bg: #07110d;
  --panel: #101c16;
  --panel-soft: #16261e;
  --text: #f3f1e7;
  --muted: #aeb8ad;
  --orange: #ff8a00;
  --orange-soft: #ffb347;
  --green: #79e07e;
  --green-soft: #153b26;
  --red: #ff6961;
  --border: #31503c;
  --code: #070d0a;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(255, 138, 0, 0.18), transparent 32%),
    radial-gradient(circle at bottom right, rgba(121, 224, 126, 0.12), transparent 35%),
    linear-gradient(135deg, #050908, var(--bg));
  color: var(--text);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.55;
}

.page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 46px 18px;
}

.panel {
  width: 100%;
  max-width: 820px;
  background:
    linear-gradient(180deg, rgba(22, 38, 30, 0.98), rgba(10, 18, 14, 0.98));
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 30px;
  box-shadow: 0 22px 90px rgba(0, 0, 0, 0.45);
}

.panel.wide {
  max-width: 960px;
}

.statusbar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid rgba(121, 224, 126, 0.28);
  border-radius: 12px;
  background: rgba(121, 224, 126, 0.07);
  color: var(--green);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.status-right {
  margin-left: auto;
  color: var(--orange-soft);
}

.dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 14px rgba(121, 224, 126, 0.85);
}

.header {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-top: 28px;
}

.reactor-icon {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: rgba(255, 138, 0, 0.14);
  border: 1px solid rgba(255, 138, 0, 0.35);
  font-size: 31px;
}

h1 {
  margin: 26px 0 8px;
  color: var(--orange-soft);
  font-size: 42px;
  line-height: 1.08;
}

.header h1 {
  margin: 0;
}

h2 {
  margin: 0 0 10px;
  color: var(--green);
  font-size: 18px;
}

.lead {
  max-width: 720px;
  color: #f7d9a8;
  font-size: 18px;
  margin-bottom: 26px;
}

.subtitle,
.footer,
.small {
  color: var(--muted);
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin: 26px 0;
}

.card,
.sample,
.readout,
.result,
.error {
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  background: rgba(255, 255, 255, 0.035);
}

.card {
  padding: 18px;
}

.card p {
  margin: 0;
  color: #d9ded4;
}

.sample {
  padding: 16px;
  margin: 22px 0;
  display: grid;
  gap: 8px;
}

.sample span {
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

code,
pre,
textarea {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

code,
pre {
  background: var(--code);
  color: #f8e6bf;
  border: 1px solid rgba(255, 138, 0, 0.22);
  border-radius: 10px;
}

code {
  padding: 10px 12px;
  display: block;
}

pre {
  padding: 15px;
  overflow-x: auto;
  white-space: pre-wrap;
}

.button,
button {
  display: inline-block;
  margin-top: 14px;
  background: var(--orange);
  color: #130d04;
  border: 0;
  border-radius: 11px;
  padding: 14px 18px;
  font-weight: 900;
  font-size: 15px;
  text-decoration: none;
  cursor: pointer;
}

.button:hover,
button:hover {
  background: var(--orange-soft);
}

.readout {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin: 26px 0;
  overflow: hidden;
}

.readout div {
  padding: 16px;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
}

.readout div:last-child {
  border-right: 0;
}

.label {
  display: block;
  color: var(--muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  margin-bottom: 4px;
}

.readout strong {
  color: var(--green);
}

label {
  display: block;
  margin-bottom: 8px;
  font-weight: 800;
  color: #ffe3b6;
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 135px;
  border: 1px solid rgba(121, 224, 126, 0.25);
  border-radius: 13px;
  background: #07100c;
  color: var(--text);
  padding: 14px;
  font-size: 15px;
  outline: none;
}

textarea:focus {
  border-color: rgba(255, 138, 0, 0.75);
  box-shadow: 0 0 0 3px rgba(255, 138, 0, 0.12);
}

.result {
  margin-top: 26px;
  padding: 18px;
  background: rgba(255, 138, 0, 0.07);
  border-color: rgba(255, 138, 0, 0.28);
}

.error {
  margin-top: 26px;
  padding: 18px;
  background: rgba(255, 105, 97, 0.08);
  border-color: rgba(255, 105, 97, 0.32);
}

.error h2 {
  color: var(--red);
}

.footer,
.small {
  margin-top: 22px;
  font-size: 13px;
}

.link {
  display: inline-block;
  margin-top: 16px;
  color: var(--orange-soft);
  font-weight: 800;
  text-decoration: none;
}

@media (max-width: 720px) {
  .panel {
    padding: 22px;
  }

  h1 {
    font-size: 34px;
  }

  .grid,
  .readout {
    grid-template-columns: 1fr;
  }

  .readout div {
    border-right: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .readout div:last-child {
    border-bottom: 0;
  }

  .status-right {
    display: none;
  }
}

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Orange Plant Debug Report</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="debug-page">
  <main class="debug-shell">
    <section class="debug-card">
      <div class="debug-header">
        <span class="badge">OPP DEBUG</span>
        <h1>Route could not be mapped by the Reception Printer Console</h1>
      </div>

      <p class="debug-lead">
        The requested path does not exist in the printer configuration interface.
        A developer hint was left in the local routing notes.
      </p>

      <div class="debug-box">
        <div class="debug-title">Suggested file to inspect</div>
        <pre># Orange Plant internal note
# Printer routes are defined in:
#
#   /printerconfig.rb
#
# The reception printer only accepts local diagnostic targets.</pre>
      </div>

      <table class="debug-table">
        <tr>
          <th>Application</th>
          <td>Orange Power Plant Reception Printer</td>
        </tr>
        <tr>
          <th>Component</th>
          <td>Backoffice printer configuration service</td>
        </tr>
        <tr>
          <th>Safety zone</th>
          <td>Reception network</td>
        </tr>
        <tr>
          <th>Hint</th>
          <td>Printer diagnostics may reveal local services.</td>
        </tr>
      </table>

      <a class="debug-link" href="/">Return to printer login</a>
    </section>
  </main>
</body>
</html>
